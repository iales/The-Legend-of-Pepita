  }
}

describe "Enemigos - Cazador" {
  
  // TEST: Verifica que el cazador se inicializa correctamente
  test "cazador se crea con 5 vidas" {
    const cazador = new Cazador(position = game.at(20, 20))
    
    assert.equals(5, cazador.vida())
    assert.equals("cazador.png", cazador.image())
    assert.that(cazador.estaVivo())
    assert.that(cazador.haceDaño())
  }
  
  // TEST: Verifica que el cazador se mueve hacia pepito cuando está a la derecha
  test "cazador se mueve hacia pepito cuando está a su derecha" {
    pepito.reiniciar()
    pepito.position(game.at(25, 10))
    const cazador = new Cazador(position = game.at(20, 10))
    const posicionInicial = cazador.position()
    
    // El cazador persigue a pepito
    cazador.perseguirPersonaje("cazadorEspalda.png", "cazador.png", "cazadorIzquierda.png", "cazadorDerecha.png")
    
    // El cazador debería moverse hacia la derecha (hacia pepito)
    assert.that(cazador.position().x() > posicionInicial.x())
  }
  
  // TEST: Verifica que el cazador se mueve hacia pepito cuando está arriba
  test "cazador se mueve hacia pepito cuando está arriba" {
    pepito.reiniciar()
    pepito.position(game.at(15, 15))
    const cazador = new Cazador(position = game.at(15, 10))
    const posicionInicial = cazador.position()
    
    // El cazador persigue a pepito
    cazador.perseguirPersonaje("cazadorEspalda.png", "cazador.png", "cazadorIzquierda.png", "cazadorDerecha.png")
    
    // El cazador debería moverse hacia arriba (hacia pepito)
    assert.that(cazador.position().y() > posicionInicial.y())
  }
}

describe "Jefe Final - Gato Boss" {
  
  // TEST: Verifica que el gato inicia con imagen de disfraz
  test "gato boss inicia disfrazado" {
    assert.equals("gatoDisfrazado1.png", gato.image())
    assert.equals(game.at(15, 20), gato.position())
  }
  
  // TEST: Verifica que el gato tiene 26 vidas
  test "gato boss tiene 26 puntos de vida" {
    assert.equals(26, gato.vida())
    assert.that(gato.estaVivo())
  }
  
  // TEST: Verifica que el gato hace daño
  test "gato boss es peligroso" {
    assert.that(gato.haceDaño())
    assert.that(gato.esPisable())
  }
  
  // TEST: Verifica que el gato puede recibir daño usando el método heredado
  test "gato boss puede perder vida" {
    const vidaInicial = gato.vida()
    
    // Llamamos directamente al método perderVida heredado de Enemigo
    gato.perderVida()
    
    assert.equals(vidaInicial - 1, gato.vida())
  }
  
  // TEST: Verifica que el SkillShot (bola de energía) se crea correctamente
  test "skillshot del gato se crea con propiedades correctas" {
    const bola = new SkillShot(position = game.at(15, 20), image = "bolaEnergia2.png", velocidad = 200, nombre = 1, rango = 20)
    
    assert.equals("bolaEnergia2.png", bola.image())
    assert.that(bola.haceDaño())
    assert.that(bola.esPisable())
  }
  
  // TEST: Verifica que los gatitos se crean correctamente
  test "gatito se inicializa con 1 vida" {
    const gatito = new Gatito(position = game.at(10, 10))
    
    assert.equals(1, gatito.vida())
    assert.equals("gatito1.png", gatito.image())
    assert.that(gatito.estaVivo())
  }
}
